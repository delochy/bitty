{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "마스코트 창 권한. 창 표시·숨김은 Rust가 직접 하고, 웹뷰(로컬 페이지)는 카드를 잡아 창을 옮길 때만 창 위치를 바꾼다.",
  "windows": [
    "mascot"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:4318/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position"
  ]
}
